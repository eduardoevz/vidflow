{
  "name": "vidflow",
  "productName": "VidFlow",
  "version": "0.1.0",
  "description": "Desktop media analyzer and downloader for Windows",
  "author": "VidFlow",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/electron/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && npm run rebuild:electron && electron .",
    "build:renderer": "vite build",
    "build:main": "tsc -p electron/tsconfig.json",
    "build:preload": "esbuild electron/preload/index.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/electron/preload/index.js",
    "build:electron": "npm run build:main && npm run build:preload",
    "build": "npm run build:renderer && npm run build:electron",
    "build:win": "npm run build && npm run rebuild:electron && electron-builder --win",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^11.3.0",
    "gsap": "^3.12.5",
    "hls.js": "^1.5.15",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  },
  "overrides": {
    "node-gyp": "^13.0.2"
  },
  "build": {
    "appId": "com.vidflow.app",
    "productName": "VidFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "database/migrations/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
