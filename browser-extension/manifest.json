{
  "manifest_version": 3,
  "name": "VidFlow Companion",
  "version": "0.1.0",
  "description": "Captura streams de video (.m3u8, .mpd, .mp4) y envía enlaces a VidFlow con un clic.",
  "permissions": ["activeTab", "webRequest", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Enviar a VidFlow"
  }
}
